# Canvas OAuth Configuration
CANVAS_API_BASE_URL=https://tecdemonterrey.test.instructure.com
CANVAS_CLIENT_ID=tu_client_id
CANVAS_CLIENT_SECRET=tu_client_secret
CANVAS_REDIRECT_URI=http://localhost:7071/api/oauth/callback
CANVAS_SCOPES=url:GET|/api/v1/courses/:id url:GET|/api/v1/courses/:course_id/assignments url:GET|/api/v1/courses/:course_id/enrollments url:GET|/api/v1/courses/:course_id/students/submissions

# Frontend URL (para CORS y redirects)
FRONTEND_URL=http://localhost:4201

# Azure Table Storage (para refresh tokens)
TABLE_STORAGE_CONNECTION=UseDevelopmentStorage=true
